{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HDXL host benchmark environment v1",
  "description": "environment.json in each framework measurement bundle. result.json contains command outcomes, binary linkage, and available per-module compilation settings.",
  "type": "object",
  "oneOf": [
    {"properties": {"measurementMode": {"const": "timing"}, "allocatorBackend": {"const": "disabled"}}},
    {"properties": {"measurementMode": {"const": "allocation"}, "allocatorBackend": {"const": "malloc-interposer"}}}
  ],
  "required": ["schemaVersion", "recordedAtUTC", "commit", "workingTreeDirty", "hardwareModel", "architecture", "hostOS", "hostOSBuild", "xcode", "swift", "sdks", "configuration", "measurementMode", "swiftPMArguments", "allocatorBackend", "externalProfiler", "preflightState", "assessment"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordedAtUTC": {"type": "string", "format": "date-time"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "workingTreeDirty": {"type": "boolean"},
    "hardwareModel": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "hostOS": {"type": "string", "minLength": 1},
    "hostOSBuild": {"type": "string", "minLength": 1},
    "xcode": {"type": "string", "minLength": 1},
    "swift": {"type": "string", "minLength": 1},
    "sdks": {
      "type": "object",
      "required": ["macosx", "iphoneos", "iphonesimulator"],
      "properties": {
        "macosx": {"$ref": "#/$defs/sdkVersion"},
        "iphoneos": {"$ref": "#/$defs/sdkVersion"},
        "iphonesimulator": {"$ref": "#/$defs/sdkVersion"}
      }
    },
    "configuration": {"const": "release"},
    "measurementMode": {"enum": ["timing", "allocation"]},
    "swiftPMArguments": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "allocatorBackend": {"enum": ["disabled", "malloc-interposer"]},
    "externalProfiler": {"enum": ["unobserved", "disabled", "active"]},
    "preflightState": {
      "type": "object",
      "required": ["powerSource", "lowPowerMode", "thermalState", "sustainedThermalState"],
      "properties": {
        "powerSource": {"enum": ["AC Power", "Battery Power", "UPS Power", "unavailable"]},
        "lowPowerMode": {"type": ["boolean", "null"]},
        "thermalState": {"enum": ["nominal", "fair", "serious", "critical", "unavailable"]},
        "sustainedThermalState": {"const": "unmeasured"}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["unscreened", "clean", "noisy", "contaminated"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {"sdkVersion": {"type": "string", "pattern": "^[0-9]+([.][0-9]+){1,2}$"}}
}
